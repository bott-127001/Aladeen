        "upper_edge": 1.1400,
        "is_line": false,
        "eligibility_available_time": "2026-10-02T08:00:00+00:00",
        "direction": "UPWARD"
      },
      "shared_timestamp": "2026-10-02T12:00:00+00:00",
      "competing_events_at_t": [
        {
          "event_type": "SOURCE_INVALIDATION",
          "event_id": "EVT_CHOCH_CLOSE",
          "order_priority": 1,
          "description": "Source H1 bar closes below last support, finalizing main CHOCH."
        },
        {
          "event_type": "POTENTIAL_CONFIRMATION_ENTRY",
          "event_id": "EVT_M1_CHOCH_CLOSE",
          "order_priority": 2,
          "description": "M1 candle closes confirming bullish pattern."
