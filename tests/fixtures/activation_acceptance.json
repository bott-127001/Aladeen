    "act_09_same_time_event_ordering": {
      "category": ["edge_boundary_specification"],
      "description": "At a shared candle close timestamp T where both source invalidation and an entry signal occur, source invalidation is evaluated first (OPEN-03, OPEN-12). Invalidated level cannot execute.",
