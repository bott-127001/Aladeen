      "expected": {
        "invalidation_applied_first": true,
        "entry_permitted": false,
        "final_state": "CANCELLED_SOURCE_CHOCH",
        "rejection_reason": "SOURCE_INVALIDATED_BEFORE_ENTRY_EVALUATION"
      }
